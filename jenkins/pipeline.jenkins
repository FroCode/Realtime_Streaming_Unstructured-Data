pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY')  
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_KEY')  
        GITHUB_TOKEN = credentials('github-token')
    }

    stages {
        stage('Checkout Repo') {
            steps {
                script {
                    // Check if the directory exists, if so, pull the latest changes
                    sh '''
                    if [ -d "Realtime_Streaming_Unstructured-Data" ]; then
                        cd Realtime_Streaming_Unstructured-Data && git pull
                    else
                        git clone https://$GITHUB_TOKEN@github.com/FroCode/Realtime_Streaming_Unstructured-Data
                    fi
                    '''
                }
            }
        }
        
        stage('Fix Repository Issues') {
            steps {
                script {
                    // Fix duplicate repository entries in sources.list
                    sh '''
                    sudo sed -i '/^deb.*hashicorp/d' /etc/apt/sources.list.d/*
                    sudo sed -i '/^deb.*kubernetes/d' /etc/apt/sources.list.d/*
                    
                    # Re-add HashiCorp repository correctly
                    echo "deb https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
                    sudo apt-get update
                    '''
                }
            }
        }

        stage('Install Terraform') {
            steps {
                script {
                    // Automatically agree to remove the existing terraform package and install the new one
                    sh '''
                    sudo apt-get remove -y terraform
                    sudo apt-get update
                    curl -fsSL https://apt.releases.hashicorp.com/gpg | sudo apt-key add -
                    sudo apt-get update
                    sudo apt-get install terraform
                    '''
                }
            }
        }
        
        stage('Initialize Terraform') {
            steps {
                script {
                    // Initialize Terraform
                    sh '''
                    cd Realtime_Streaming_Unstructured-Data/terraform
                    terraform init
                    '''
                }
            }
        }
        
        stage('Apply Terraform') {
            steps {
                script {
                    // Apply Terraform configuration
                    sh '''
                    cd Realtime_Streaming_Unstructured-Data/terraform
                    terraform apply -auto-approve
                    '''
                }
            }
        }
    }
}
